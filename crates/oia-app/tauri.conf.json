{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OIA",
  "version": "0.1.0",
  "identifier": "org.oia.workbench",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "OIA — Local research workbench",
      "width": 1380, "height": 900, "minWidth": 640, "minHeight": 540,
      "center": true, "backgroundColor": "#000000"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/oia.ico"] }
}
